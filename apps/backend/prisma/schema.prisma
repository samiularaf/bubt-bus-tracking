// Prisma schema — mirrors schema.sql (Phase 3, DATABASE_DESIGN.md).
// `prisma migrate dev` will generate migrations from this file going forward;
// schema.sql remains the original hand-written reference for that design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  user
  driver
  admin
}

enum UserDesignation {
  student
  teacher
  staff
}

enum AccountStatus {
  active
  inactive
}

enum ScheduleType {
  regular
  ramadan
  exam
  holiday
  special
}

/// Sun-Thu vs Friday timing pattern. Saturday has no service — no template needed.
enum DayGroup {
  sun_thu
  friday
}

enum TripStatus {
  upcoming
  running
  completed
}

enum NoticeCategory {
  general
  holiday
  ramadan
  exam
  delay
  cancellation
  emergency
  maintenance
}

enum NotificationType {
  reminder_15min
  trip_started
  notice
  emergency
  delay
  cancellation
  schedule_change
}

// ============================================================================
// CORE DOMAIN
// ============================================================================

model User {
  id                  String          @id @default(uuid())
  role                UserRole
  name                String

  // User-role fields
  email               String?         @unique
  emailVerified       Boolean         @default(false) @map("email_verified")
  designation         UserDesignation?
  idNumber            String?         @map("id_number")

  passwordHash        String          @map("password_hash")

  // Driver-role fields
  driverId            String?         @unique @map("driver_id")
  phone               String?
  bloodGroup          String?         @map("blood_group")
  nidOrLicense        String?         @map("nid_or_license")
  address             String?
  emergencyContact    String?         @map("emergency_contact")
  photoUrl            String?         @map("photo_url")
  assignedBusId       String?         @unique @map("assigned_bus_id")
  assignedBus         Bus?            @relation("DriverAssignedBus", fields: [assignedBusId], references: [id])
  joiningDate         DateTime?       @map("joining_date") @db.Date
  mustChangePassword  Boolean         @default(false) @map("must_change_password")

  // Admin-role fields
  adminId             String?         @unique @map("admin_id")

  status              AccountStatus   @default(active)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  driverTrips         Trip[]          @relation("TripDriver")
  reminders           Reminder[]
  favoriteBuses       FavoriteBus[]
  complaints          Complaint[]
  notices             Notice[]        @relation("NoticeCreatedBy")
  otpCodes            OtpCode[]
  refreshTokens       RefreshToken[]
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]
  emergencyAlerts     EmergencyAlert[]

  @@map("users")
}

model Route {
  id         String   @id @default(uuid())
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  stops      Stop[]
  buses      Bus[]

  @@map("routes")
}

model Stop {
  id         String   @id @default(uuid())
  routeId    String   @map("route_id")
  route      Route    @relation(fields: [routeId], references: [id])
  name       String
  latitude   Float
  longitude  Float
  stopOrder  Int      @map("stop_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([routeId, stopOrder])
  @@map("stops")
}

model Bus {
  id         String   @id @default(uuid())
  busNumber  String   @unique @map("bus_number")
  routeId    String   @map("route_id")
  route      Route    @relation(fields: [routeId], references: [id])
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  driver              User?                   @relation("DriverAssignedBus")
  trips               Trip[]
  scheduleTemplates   ScheduleTripTemplate[]
  favoritedBy         FavoriteBus[]

  @@map("buses")
}

model Schedule {
  id         String       @id @default(uuid())
  name       String
  type       ScheduleType
  isActive   Boolean      @default(false) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  templates  ScheduleTripTemplate[]

  @@map("schedules")
}

model ScheduleTripTemplate {
  id              String    @id @default(uuid())
  scheduleId      String    @map("schedule_id")
  schedule        Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  busId           String    @map("bus_id")
  bus             Bus       @relation(fields: [busId], references: [id])
  dayGroup        DayGroup  @map("day_group")
  departureTime   DateTime  @map("departure_time") @db.Time
  createdAt       DateTime  @default(now()) @map("created_at")

  trips           Trip[]

  @@unique([scheduleId, busId, dayGroup, departureTime])
  @@map("schedule_trip_templates")
}

model Trip {
  id                       String                 @id @default(uuid())
  busId                    String                 @map("bus_id")
  bus                      Bus                    @relation(fields: [busId], references: [id])
  scheduleTripTemplateId   String?                @map("schedule_trip_template_id")
  scheduleTripTemplate     ScheduleTripTemplate?  @relation(fields: [scheduleTripTemplateId], references: [id])
  driverId                 String?                @map("driver_id")
  driver                   User?                  @relation("TripDriver", fields: [driverId], references: [id])
  tripDate                 DateTime               @map("trip_date") @db.Date
  scheduledTimeUtc         DateTime               @map("scheduled_time_utc")
  status                   TripStatus             @default(upcoming)
  startedAt                DateTime?              @map("started_at")
  completedAt              DateTime?              @map("completed_at")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")

  positions                TripPosition[]
  reminders                Reminder[]
  notifications            Notification[]
  emergencyAlerts          EmergencyAlert[]

  @@unique([busId, scheduledTimeUtc])
  @@map("trips")
}

model TripPosition {
  id          BigInt   @id @default(autoincrement())
  tripId      String   @map("trip_id")
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  latitude    Float
  longitude   Float
  speedKmh    Float?   @map("speed_kmh")
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@map("trip_positions")
}

model Reminder {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId              String   @map("trip_id")
  trip                Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  notified15min       Boolean  @default(false) @map("notified_15min")
  notifiedTripStart   Boolean  @default(false) @map("notified_trip_start")
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([userId, tripId])
  @@map("reminders")
}

model FavoriteBus {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  busId      String   @map("bus_id")
  bus        Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, busId])
  @@map("favorite_buses")
}

model Notice {
  id            String         @id @default(uuid())
  title         String
  body          String
  category      NoticeCategory
  createdBy     String         @map("created_by")
  creator       User           @relation("NoticeCreatedBy", fields: [createdBy], references: [id])
  publishedAt   DateTime       @default(now()) @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  notifications Notification[]

  @@map("notices")
}

model Complaint {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    String
  message    String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("complaints")
}

// ============================================================================
// AUXILIARY
// ============================================================================

model OtpCode {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash      String   @map("code_hash")
  expiresAt     DateTime @map("expires_at")
  consumed      Boolean  @default(false)
  attemptCount  Int      @default(0) @map("attempt_count")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("otp_codes")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model PushSubscription {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String
  p256dh     String
  auth       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

model Notification {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             NotificationType
  title            String
  body             String
  relatedTripId    String?           @map("related_trip_id")
  relatedTrip      Trip?             @relation(fields: [relatedTripId], references: [id], onDelete: Cascade)
  relatedNoticeId  String?           @map("related_notice_id")
  relatedNotice    Notice?           @relation(fields: [relatedNoticeId], references: [id], onDelete: Cascade)
  isRead           Boolean           @default(false) @map("is_read")
  createdAt        DateTime          @default(now()) @map("created_at")

  @@map("notifications")
}

model EmergencyAlert {
  id         String   @id @default(uuid())
  tripId     String   @map("trip_id")
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverId   String   @map("driver_id")
  driver     User     @relation(fields: [driverId], references: [id])
  message    String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("emergency_alerts")
}
