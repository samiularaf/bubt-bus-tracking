# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (Supabase PostgreSQL connection strings)
# DATABASE_URL: the pooled connection (Supabase's "Transaction" pooler, port 6543) — used by the app at runtime.
# DIRECT_URL: the direct connection (port 5432) — used only for migrations, which the pooler doesn't support well.
# Both come from Supabase dashboard: Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bubt_bus_tracking
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/bubt_bus_tracking

# JWT
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:transport@bubt.edu.bd

# OTP
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Data retention
TRIP_POSITION_RETENTION_DAYS=30
